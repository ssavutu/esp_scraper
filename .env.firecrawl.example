# Firecrawl local self-hosted settings
PORT=3002
USE_DB_AUTHENTICATION=false
BULL_AUTH_KEY=CHANGEME

# Local PostgreSQL credentials (dev defaults)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Optional AI / extraction settings
# Leave OPENAI_* unset when using local Ollama
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://host.docker.internal:11434/api
MODEL_NAME=llama3.1:8b
MODEL_EMBEDDING_NAME=nomic-embed-text

# Optional scraping proxy
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Optional controls
# CRAWL_CONCURRENT_REQUESTS=10
# ALLOW_LOCAL_WEBHOOKS=true
# BLOCK_MEDIA=true

# Optional Playwright service settings
# PLAYWRIGHT_PORT=3000
# Default uses Docker service name; set localhost URL only if you intentionally run
# Playwright outside this compose stack.
# PLAYWRIGHT_MICROSERVICE_URL=http://localhost:3000/scrape
